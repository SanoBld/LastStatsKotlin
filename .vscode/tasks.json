{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build debug APK",
      "type": "shell",
      "command": ".\\gradlew.bat",
      "args": [
        ":app:assembleDebug"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "Install debug on device",
      "type": "shell",
      "command": ".\\gradlew.bat",
      "args": [
        ":app:installDebug"
      ],
      "problemMatcher": []
    },
    {
      "label": "Build release APKs (all ABIs)",
      "type": "shell",
      "command": ".\\gradlew.bat",
      "args": [
        ":app:assembleRelease",
        "-PabiSplits=true"
      ],
      "problemMatcher": []
    },
    {
      "label": "Clean",
      "type": "shell",
      "command": ".\\gradlew.bat",
      "args": [
        "clean"
      ],
      "problemMatcher": []
    },
    {
      "label": "Run desktop app",
      "type": "shell",
      "command": ".\\gradlew.bat",
      "args": [
        ":desktop:run"
      ],
      "problemMatcher": []
    },
    {
      "label": "Package desktop installer (this OS)",
      "type": "shell",
      "command": ".\\gradlew.bat",
      "args": [
        ":desktop:createDistributable"
      ],
      "problemMatcher": []
    },
    {
      "label": "Unit tests (shared)",
      "type": "shell",
      "command": ".\\gradlew.bat",
      "args": [
        ":shared:desktopTest"
      ],
      "problemMatcher": [],
      "group": "test"
    },
    {
      "label": "Lint (Android)",
      "type": "shell",
      "command": ".\\gradlew.bat",
      "args": [
        ":app:lintDebug"
      ],
      "problemMatcher": []
    },
    {
      "label": "Generate string tables",
      "type": "shell",
      "command": "python",
      "args": [
        "tools/gen_strings.py"
      ],
      "problemMatcher": []
    }
  ]
}