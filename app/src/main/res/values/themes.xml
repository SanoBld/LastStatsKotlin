<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.LastStats" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/ls_window_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.LaunchTheme" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/ic_bg_blue</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_fg_white</item>
        <item name="postSplashScreenTheme">@style/Theme.LastStats</item>
    </style>
</resources>
